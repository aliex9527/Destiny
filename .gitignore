# 构建中间产物
build/

# 安装包不进仓库，统一走 Release 附件分发
dist/

# 本地工具链（JDK + Android SDK，约 470 MB，不入库）
toolchain/

# 签名密钥只留在本地，绝不入库（含 base64 副本）
keystore/

# 原始抓取数据与临时脚本产物
data/
.workbuddy/
__pycache__/
*.pyc

# CI 回传的构建日志
ci-build.log
.ci/

# 本机临时日志
debug.log
*.log

# Rust 构建产物（实际落在 C:/rsbuild，这里兜底）
rust/target/
Cargo.lock.bak

# 字体子集是构建产物，且源字体随系统，不入库（构建前跑 tools/make_font.py）
rust/assets/font_regular.ttf
rust/assets/font_bold.ttf
